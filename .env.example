# SceneSense AI v5.0 - Environment Variables
# =============================================
# Copy this file to .env and fill in your API keys

# Required: Groq API Key for LLM inference (free at console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Required for Shot Images: Gemini API Key (free at aistudio.google.com)
# Nano Banana = Gemini 2.5 Flash Image — ~500 images/day FREE
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Qubrid API Key for Llama 3.3 70B
QUBRID_API_KEY=your_qubrid_api_key_here
